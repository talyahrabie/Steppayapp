# ─────────────────────────────────────────────────────────────────────────────
# StePPay environment configuration.
# Copy this file to `.env` and fill in your own values, then restart Expo.
# `.env` is git-ignored — NEVER commit real keys to the repository.
# Values come from: Supabase dashboard → Project Settings → API
# ─────────────────────────────────────────────────────────────────────────────

# Cloud Supabase project (the single backend for the whole app)
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Social sign-in gates. Set to "true" only AFTER the provider is fully
# configured in the Supabase dashboard (Authentication → Providers).
# While unset/false, the login screen honestly reports "not configured yet".
EXPO_PUBLIC_GOOGLE_AUTH_ENABLED=false
EXPO_PUBLIC_APPLE_AUTH_ENABLED=false
